# Matchfile - Configuration for fastlane match

# Git repository URL for storing certificates and profiles
# You can use a private GitHub/GitLab/Bitbucket repository
git_url(ENV["MATCH_GIT_URL"])

# Git branch to use (optional, defaults to master)
git_branch("main")

# Storage mode (git, google_cloud, s3, gitlab_secure_files)
storage_mode("git")

# App identifier (bundle ID)
app_identifier(ENV["BUNDLE_ID"])

# Apple Team ID
team_id(ENV["APPLE_TEAM_ID"])

# Type of certificate (appstore, adhoc, development, enterprise)
type("appstore")

# Username (Apple ID) - optional if using App Store Connect API Key
username(ENV["APPLE_ID"])

# Keychain name and password for CI
keychain_name("fastlane_match")
keychain_password(ENV["MATCH_KEYCHAIN_PASSWORD"])
