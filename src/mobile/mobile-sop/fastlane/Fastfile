default_platform(:ios)

platform :android do
  desc "Build Android APK/AAB for distribution"
  lane :build do |options|
    # Get configuration from environment
    build_type = options[:build_type] || ENV['BUILD_TYPE'] || "aab"
    task = build_type == "apk" ? "assemble" : "bundle"

    gradle(
      task: task,
      build_type: "Release",
      project_dir: "./android",
      properties: {
        "android.injected.signing.store.file" => ENV['KEYSTORE_PATH'],
        "android.injected.signing.store.password" => ENV['KEYSTORE_PASSWORD'],
        "android.injected.signing.key.alias" => ENV['KEY_ALIAS'],
        "android.injected.signing.key.password" => ENV['KEY_PASSWORD']
      }
    )
  end
end

platform :ios do
  desc "Build iOS app for distribution"
  lane :build do |options|
    # Setup CI keychain
    setup_ci

    # Get configuration from options or environment
    export_method = options[:export_method] || ENV['EXPORT_METHOD']

    # Determine match type based on export method
    match_type = case export_method
      when "ad-hoc" then "adhoc"
      when "development" then "development"
      when "enterprise" then "enterprise"
      else "appstore"
    end

    # Sync certificates and provisioning profiles
    match(
      type: match_type,
      readonly: true,
      git_url: ENV['MATCH_GIT_URL'],
      git_branch: "main",
      git_basic_authorization: ENV['MATCH_GIT_BASIC_AUTHORIZATION'],
      app_identifier: ENV['BUNDLE_ID'],
      team_id: ENV['APPLE_TEAM_ID']
    )

    # Build the app
    workspace_name = ENV['APP_NAME'].delete(' ')

    # Get the provisioning profile UUID that match just installed
    profile_uuid = ENV["sigh_#{ENV['BUNDLE_ID']}_#{match_type}"]

    build_app(
      workspace: "./ios/#{workspace_name}.xcworkspace",
      scheme: workspace_name,
      configuration: "Release",
      export_method: export_method,
      output_directory: "./ios/export",
      output_name: "#{ENV['APP_NAME']}.ipa",
      xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} PROVISIONING_PROFILE=#{profile_uuid} CODE_SIGN_IDENTITY='Apple Distribution'",
      clean: true
    )
  end
end
