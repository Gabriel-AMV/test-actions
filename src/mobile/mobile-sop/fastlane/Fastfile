# Fastfile for iOS CI/CD

default_platform(:ios)

platform :ios do

  desc "Sync certificates and provisioning profiles using Match"
  lane :sync_certificates do |options|
    match(
      type: options[:type] || "appstore",  # appstore, adhoc, development, enterprise
      readonly: options[:readonly] || true,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      app_identifier: ENV["BUNDLE_ID"],
      team_id: ENV["APPLE_TEAM_ID"]
    )
  end

  desc "Build iOS app"
  lane :build do |options|
    # Get parameters
    export_method = options[:export_method] || "app-store"
    configuration = options[:configuration] || "Release"

    # Determine match type based on export method
    match_type = case export_method
    when "app-store"
      "appstore"
    when "ad-hoc"
      "adhoc"
    when "development"
      "development"
    when "enterprise"
      "enterprise"
    else
      "appstore"
    end

    # Sync certificates and profiles
    sync_certificates(type: match_type, readonly: true)

    # Get app name and create workspace/scheme names
    app_name = ENV["APP_NAME"]
    workspace_name = app_name.gsub(" ", "")
    scheme_name = app_name.gsub(" ", "")

    # Build the app
    build_app(
      workspace: "ios/#{workspace_name}.xcworkspace",
      scheme: scheme_name,
      configuration: configuration,
      export_method: export_method,
      output_directory: "ios/export",
      output_name: "#{app_name}.ipa",
      clean: true,
      export_team_id: ENV["APPLE_TEAM_ID"],
      codesigning_identity: "Apple Distribution",
      xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}",
      export_options: {
        provisioningProfiles: {
          ENV["BUNDLE_ID"] => "match #{match_type.capitalize} #{ENV['BUNDLE_ID']}"
        }
      }
    )
  end
end
